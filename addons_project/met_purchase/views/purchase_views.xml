<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="purchase_order_form_inherit_met_purchase" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page/field[@name='order_line']//field[@name='price_unit']"
                position="after">
                <field name="supplier_product_code" />
            </xpath>         
        </field>
    </record>

    <record id="view_purchase_order_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="supplier_product_code"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_filter_inherit_met_purchase" model="ir.ui.view">
        <field name="name">request.quotation.select.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field" position="after">
                <field name="supplier_product_code" />
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="CIP" name="supplier_product_code" domain="[]"
                    context="{'group_by': 'supplier_product_code'}" />
            </xpath>
        </field>
    </record>

</odoo>