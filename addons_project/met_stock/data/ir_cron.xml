<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_auto_check_stock_warehouse_orderpoint" model="ir.cron">
            <field name="name">Réassort</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=11, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="model_id" ref="model_stock_warehouse_orderpoint"/>
            <field name="code">model.action_check_orderpoint_and_create_purchase()</field>
            <field name="state">code</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>
