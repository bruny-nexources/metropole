<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">
    <t t-name="pos_editable_product_name.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//OrderlineNoteButton[1]" position="after">
            <OrderlineProductNoteButton label="productNoteLabel()" getter="(orderline) => orderline.getProductNote()" class="buttonClass" setter="(orderline, note) => orderline.setProductNote(note)" />
        </xpath>
    </t>
</templates>