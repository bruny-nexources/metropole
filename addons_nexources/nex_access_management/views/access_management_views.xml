<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="access_management_form_view_inherit" model="ir.ui.view">
        <field name="name">access_management_form_view_inherit</field>
        <field name="model">access.management</field>
        <field name="inherit_id" ref="simplify_access_management.access_management_form_view_ah"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='disable_debug_mode']" position="before">
                <field name="role_ids" widget='many2many_tags' options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string='Unauthorized users'>
                    <field name="user_ids" widget='many2many_tags' options="{'no_create': True}" domain="[('share','=',False)]"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
